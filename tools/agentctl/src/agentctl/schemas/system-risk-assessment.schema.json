{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "System risk assessment structure",
  "description": "Structural guard before semantic risk and cross-artifact checks. Does not establish production readiness.",
  "type": "object",
  "required": [
    "scope",
    "regulatory_screen",
    "acceptance",
    "monitoring",
    "assessment",
    "classification",
    "member_assessments",
    "scenarios"
  ],
  "properties": {
    "scope": {
      "type": "object"
    },
    "regulatory_screen": {
      "type": "object"
    },
    "acceptance": {
      "type": "object"
    },
    "monitoring": {
      "type": "object"
    },
    "assessment": {
      "type": "object",
      "required": [
        "system",
        "system_version",
        "assessment_version",
        "status",
        "assessed_at",
        "review_by",
        "prepared_by"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "system_version": {
          "type": "string",
          "minLength": 1
        },
        "assessment_version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "assessed_at": {
          "type": "string",
          "minLength": 1
        },
        "review_by": {
          "type": "string",
          "minLength": 1
        },
        "prepared_by": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "classification": {
      "type": "object",
      "required": [
        "governance_tier",
        "maximum_member_tier",
        "maximum_inherent_tier",
        "maximum_residual_tier",
        "decision"
      ],
      "properties": {
        "governance_tier": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "maximum_member_tier": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "maximum_inherent_tier": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "maximum_residual_tier": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "decision": {
          "enum": [
            "go",
            "conditional_go",
            "no_go"
          ]
        }
      }
    },
    "member_assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "agent",
          "agent_version",
          "assessment",
          "governance_tier"
        ],
        "properties": {
          "agent": {
            "type": "string",
            "minLength": 1
          },
          "agent_version": {
            "type": "string",
            "minLength": 1
          },
          "assessment": {
            "type": "string",
            "minLength": 1
          },
          "governance_tier": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "inherent",
          "residual"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "inherent": {
            "type": "object",
            "required": [
              "impact",
              "likelihood",
              "tier"
            ],
            "properties": {
              "impact": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "likelihood": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "tier": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              }
            }
          },
          "residual": {
            "type": "object",
            "required": [
              "impact",
              "likelihood",
              "tier"
            ],
            "properties": {
              "impact": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "likelihood": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "tier": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              }
            }
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "effectiveness": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array"
                }
              }
            }
          }
        }
      }
    }
  }
}
