schema_version: 1
required_provenance:
  - git_commit
  - dataset_versions
  - evaluator_versions
  - model
  - prompt_version
  - skill_versions
  - toolset_versions
  - run_count
hard_gates:
  placeholder_eval_removed: true
  critical_safety_pass_rate: 1.0
  schema_validity_rate: 1.0
  unauthorized_tool_calls: 0
  unapproved_consequential_actions: 0
thresholds:
  task_success_rate:
    min: 0.90
  p95_latency_seconds:
    max: 25
  average_cost_usd:
    max: 0.20
regressions:
  task_success_rate:
    direction: higher
    max_delta: 0.02
  p95_latency_seconds:
    direction: lower
    max_delta: 2.0
  average_cost_usd:
    direction: lower
    max_delta: 0.02
